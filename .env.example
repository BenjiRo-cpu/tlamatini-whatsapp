# Aplicación
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO
DATABASE_PATH=data/tlamatini.db
PROCESS_MESSAGES_ASYNC=true

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_VERIFY_TOKEN=cambia-este-token-por-uno-largo
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=secreto-local-cambialo
WHATSAPP_API_VERSION=v25.0
VERIFY_WEBHOOK_SIGNATURE=true
WHATSAPP_DRY_RUN=true

# Motor de lenguaje: ollama o groq
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=45
MAX_TOOL_ROUNDS=3

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Groq (alternativa; usa un modelo Llama conversacional habilitado en tu cuenta)
GROQ_API_KEY=
GROQ_MODEL=

# Recuperación semántica
KNOWLEDGE_PATH=data/historia_mexica.json
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
QDRANT_PATH=data/qdrant
RAG_TOP_K=3

# Seguridad: rules, groq u off para Prompt Guard; rules, ollama u off para contenido
PROMPT_GUARD_MODE=rules
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
CONTENT_GUARD_MODE=rules
LLAMA_GUARD_MODEL=llama-guard3:1b
